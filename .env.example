# LLM API Keys (Optional - app works in demo mode without these)
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# LLM Configuration
# openai | anthropic | demo (demo = deterministic rules, no API call)
LLM_PROVIDER=demo
# Optional. Defaults: openai -> gpt-4, anthropic -> claude-opus-5-5
# LLM_MODEL=

# Database
DATABASE_URL=sqlite:///./purchasing_agent.db

# Application
DEBUG=true

# API security
# Required for any write request when set; human approve/reject endpoints are disabled without it.
# Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Comma-separated browser origins allowed by CORS (default: http://localhost:3000)
# CORS_ORIGINS=http://localhost:3000
# Bind address (default 127.0.0.1)
# HOST=127.0.0.1
