# LLM API Keys (Optional - app works in demo mode without these)
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# LLM Configuration
LLM_PROVIDER=openai  # openai | anthropic | demo
LLM_MODEL=gpt-4  # gpt-4, gpt-3.5-turbo, claude-3-opus-20240229, etc.

# Database
DATABASE_URL=sqlite:///./purchasing_agent.db

# Application
DEBUG=true
